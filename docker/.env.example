# ============================================================================
# Linux.do 自动刷帖 Docker 配置
# ============================================================================
# 复制此文件为 .env 并填入你的账号信息
#   cp .env.example .env
#   nano .env
# ============================================================================

# 【必填】Linux.do 账号
LINUXDO_USERNAME=你的用户名
LINUXDO_PASSWORD=你的密码

# 【可选】每天运行次数（默认 2 次）
RUNS_PER_DAY=2

# 【可选】每次浏览帖子数范围（默认 15-40）
TOPICS_MIN=15
TOPICS_MAX=40

# 【可选】点赞概率 0-100（默认 30）
LIKE_RATE=30

# 【可选】首次启动是否立即运行（默认 true）
RUN_ON_START=true

# 【可选】调试模式（默认关闭）
# DEBUG=1

# ----------------------------------------------------------------------------
# 【可选】WxPusher 微信推送（运行结果通知）
#   开通：https://wxpusher.zjiecode.com/ 微信扫码登录 -> 新建应用拿 APP_TOKEN
#   微信关注生成的二维码，或在「用户管理」拿到 UID
#   不填则不发送通知
# ----------------------------------------------------------------------------
# WXPUSHER_APP_TOKEN=AT_xxxxxxxxxxxxxxxx
# WXPUSHER_UIDS=UID_xxxxxxxxxxxxxxxx
# WXPUSHER_TOPIC_IDS=

